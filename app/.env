# Base URL of the catalog (catalog.json, manifest.json, images/).
# In development and preview, /catalog/ is served from ../catalog/dist/ (see build/serve-catalog.ts).
VITE_CATALOG_BASE_URL=/catalog/

# Google OAuth client ID for the Drive sync (docs/sync-spec.md §9). Empty: sync is off.
# Public value; set it in .env.local for development, and as the GOOGLE_CLIENT_ID variable in CI.
VITE_GOOGLE_CLIENT_ID=
